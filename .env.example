# Copy this file to `.env` (never commit .env) and fill in ONE of the keys.
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides
# ML_PROVIDER=gemini        # or anthropic (which to try first if both keys exist)
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-haiku-5-5

# MySQL (used by db.js, `npm run db:setup`, and generated routes)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=optiscript_demo
