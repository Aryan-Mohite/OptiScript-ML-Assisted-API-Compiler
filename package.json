{
  "name": "optiscript",
  "version": "0.1.0",
  "description": "ML-assisted DSL compiler: custom syntax -> Express.js routes + MySQL queries",
  "main": "compiler/compiler.js",
  "scripts": {
    "test:lexer": "node compiler/lexer/test-lexer.js",
    "test:parser": "node compiler/parser/test-parser.js",
    "test:symbols": "node compiler/semantic/test-symbolTable.js",
    "test:mlrecovery": "node compiler/parser/mlRecovery.test.js",
    "test:icg": "node compiler/icg/test-icg.js",
    "test:optimizer": "node compiler/optimizer/test-optimizer.js",
    "test:codegen": "node compiler/codegen/test-codegen.js",
    "test:compiler": "node compiler/test-compiler.js",
    "test:db": "node server/test-bridge.js",
    "db:setup": "node server/db-setup.js",
    "start": "node server/server.js",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.24.5"
  }
}
